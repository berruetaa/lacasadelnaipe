{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!!**/.wrangler",
      "!!**/node_modules",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!data/catalog/public-index.json",
      "!!data/catalog/redirect-index.json",
      "!!data/research/batches/*/batch.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
