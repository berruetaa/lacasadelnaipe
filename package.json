{
  "name": "@lacasadelnaipe/root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lacasadelnaipe/web dev",
    "build": "pnpm --filter @lacasadelnaipe/web build",
    "deploy": "pnpm --filter @lacasadelnaipe/web deploy",
    "check": "biome ci .",
    "check:write": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "catalog:validate": "pnpm --filter @lacasadelnaipe/catalog catalog:validate",
    "catalog:import": "node scripts/catalog/import-d1.mjs",
    "cf:typegen": "pnpm --filter @lacasadelnaipe/web cf:typegen",
    "db:generate": "pnpm --filter @lacasadelnaipe/db db:generate",
    "db:migrate:local": "pnpm --filter @lacasadelnaipe/db db:migrate:local",
    "db:migrate:remote": "pnpm --filter @lacasadelnaipe/db db:migrate:remote",
    "db:studio": "pnpm --filter @lacasadelnaipe/db db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
