{
  "name": "@lacasadelnaipe/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lacasadelnaipe --local --config ../../apps/web/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply lacasadelnaipe --remote --config ../../apps/web/wrangler.jsonc",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@lacasadelnaipe/catalog": "workspace:*",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260920.1",
    "@types/node": "24.13.6",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.129.1"
  }
}
